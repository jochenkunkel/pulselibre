<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PulsLibre" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="alertDialogTheme">@style/ThemeOverlay.PulsLibre.Dialog</item>
        <item name="colorAccent">@color/pl_accent</item>
    </style>

    <style name="ThemeOverlay.PulsLibre.Dialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:textColorPrimary">@color/pl_ink</item>
        <item name="android:textColorSecondary">@color/pl_muted</item>
        <item name="colorAccent">@color/pl_accent</item>
        <item name="buttonBarButtonStyle">@style/Widget.PulsLibre.DialogButton</item>
    </style>

    <!-- Normal case ("Schließen") instead of the all-caps default ("SCHLIESSEN"). -->
    <style name="Widget.PulsLibre.DialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/pl_accent</item>
    </style>
</resources>
