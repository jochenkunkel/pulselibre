    <string name="main_rec_confirm_title">Start CIRQA collection</string>
    <!-- REVIEW: heikler Text, Freigabe Projektinhaber -->
    <string name="main_rec_confirm_message">PulsLibre actively connects to the CIRQA band via Bluetooth and receives the available real-time measurements over an ongoing connection. If the connection drops, the app tries to reconnect. The measurements are stored locally on this device. No historical FIT data is loaded. Android meanwhile shows a permanent notification with a stop button (Android 13+: notifications must be allowed); the system can still end the service. Garmin Connect can affect the Bluetooth connection. Start now?</string>
