    <string name="main_rec_stop">Detener</string>
    <string name="main_rec_stop_failed">No se pudo solicitar la detención.</string>
    <string name="main_rec_start_failed">Error al iniciar. Revisa el Bluetooth y los permisos de Android.</string>
    <string name="main_rec_confirm_title">Iniciar la recogida de CIRQA</string>
    <!-- REVIEW: heikler Text, Freigabe Projektinhaber -->
    <string name="main_rec_confirm_message">PulsLibre se conecta activamente a la pulsera CIRQA por Bluetooth y recibe las mediciones en tiempo real disponibles a través de una conexión continua. Si la conexión se interrumpe, la app intenta reconectar. Las mediciones se guardan localmente en este dispositivo. No se cargan datos históricos FIT. Mientras tanto, Android muestra una notificación permanente con un botón de detención (Android 13+: las notificaciones deben estar permitidas); el sistema aún puede finalizar el servicio. Garmin Connect puede afectar a la conexión Bluetooth. ¿Iniciar ahora?</string>
