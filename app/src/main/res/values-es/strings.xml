    <string name="recording_heading">Grabación</string>
    <!-- REVIEW: heikler Text, Freigabe Projektinhaber -->
    <string name="recording_info">Si está activado, PulsLibre inicia automáticamente el servicio de grabación al abrir la app y se conecta a la pulsera CIRQA. Esto solo ocurre si el Bluetooth ya está encendido y los permisos ya se han concedido; PulsLibre nunca enciende el Bluetooth por sí misma. Por defecto: desactivado. Las grabaciones en curso no se inician dos veces. Sigues pudiendo detenerlas en la app o desde la notificación.</string>
